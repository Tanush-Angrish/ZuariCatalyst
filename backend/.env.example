# ─── Database ──────────────────────────────────────────────────────────────────
# Prisma connection string — SQLite for local dev, Postgres for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/zuari_catalyst"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# NODE_ENV=production

# ─── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED — Must be set before starting the server.
# Generate a strong secret (run this once):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse between environments. Never commit the actual value.
JWT_SECRET=your_strong_random_secret_here

# ─── Microsoft Azure AD (SSO Login) ───────────────────────────────────────────
# Tenant ID: found in Azure Portal → Azure Active Directory → Overview
AZURE_TENANT_ID=your_azure_tenant_id_here
# Client ID: found in Azure Portal → App Registrations → your app → Overview
AZURE_CLIENT_ID=your_azure_client_id_here

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Used for idea insights, form autofill, template generation, project planning
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
# SMTP credentials for sending notification emails
EMAIL_USER=your_email@adventz.com
EMAIL_PASS=your_email_app_password
