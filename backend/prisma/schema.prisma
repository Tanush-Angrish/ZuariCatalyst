// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  role          String
  name          String
  title         String   @default("")
  password      String   @default("password")
  organization  String?  
  
  // Relations
  authoredIdeas Idea[]         @relation("IdeaAuthor")
  assignedIdeas Idea[]         @relation("IdeaAssignee")
  notifications Notification[] @relation("UserNotifications")

  @@map("users")
}

model Idea {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  department     String
  expectedImpact String
  supportingLink String?
  extraFields    String   @default("{}") // Storing JSON as string to match old sqlite approach initially
  files          String   @default("[]") // JSON array of { name, url, type } objects
  status         String   @default("Pending Review")
  aiSummary      String?
  aiTags         String   @default("[]") // JSON array of tags
  createdAt      DateTime @default(now())

  authorId       Int
  assignedToId   Int?

  // Relations
  author         User     @relation("IdeaAuthor", fields: [authorId], references: [id])
  assignedTo     User?    @relation("IdeaAssignee", fields: [assignedToId], references: [id])

  @@map("ideas")
}

model IdeaTemplate {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String   @default("")
  fields      String   @default("[]") // JSON array of field definitions
  fieldOrder  String   @default("[]") // JSON array of field IDs in display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("idea_templates")
}

model FormField {
  id         Int      @id @default(autoincrement())
  formType   String
  fieldName  String
  fieldLabel String
  fieldType  String   @default("text")
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)
  options    String   @default("[]") // Storing JSON array as string
  isSystem   Boolean  @default(false)

  @@map("form_fields")
}

model TemplateAccess {
  id           Int     @id @default(autoincrement())
  templateId   String
  organization String
  hasAccess    Boolean @default(false)

  @@unique([templateId, organization])
  @@map("template_access")
}

// ─── Project Lifecycle Models ────────────────────────────────────────────────

model Project {
  id          Int       @id @default(autoincrement())
  projectId   String    @unique // e.g. PROJ-0001
  ideaId      Int       @unique
  orgId       String    // organization name
  createdById Int       // authorId of the original idea
  title       String
  aiSummary   String?
  status      String    @default("Initiated")
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  steps       ProjectStep[]
  messages    ProjectMessage[]

  @@map("projects")
}

model ProjectStep {
  id          Int       @id @default(autoincrement())
  projectId   Int
  description String
  status      String    @default("Pending") // Pending | In Progress | Completed
  deadline    DateTime?

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_steps")
}

model ProjectMessage {
  id             Int      @id @default(autoincrement())
  projectId      Int
  senderId       Int
  senderName     String
  message        String
  mentionedUsers String   @default("[]") // JSON array of user ids
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_messages")
}

// ─── Notification Model ──────────────────────────────────────────────────────

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  message     String
  type        String   // 'idea', 'project', 'mention'
  referenceId Int?     // ideaId or projectId
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
